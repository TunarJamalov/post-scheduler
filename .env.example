PORT=3100
HOST=0.0.0.0
TRUST_PROXY=loopback
DATABASE_PATH=./data/posts.db

# Admin sign-in. All three are required together. Generate the key with: openssl rand -base64 48
# The key also encrypts the stored account tokens, so keep it backed up.
ADMIN_USERNAME=
ADMIN_PASSWORD=
AUTH_ENCRYPTION_KEY=

# How often the scheduler looks for due posts, in seconds
SCHEDULER_INTERVAL=15
# How many times a failed publish is retried before the post is marked failed
MAX_ATTEMPTS=3
